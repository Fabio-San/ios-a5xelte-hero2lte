diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -166,5 +166,7 @@
  * touch supplies, to find vdd_g3d (BUCK6). Nothing is written.
  */
-extern bool herolte_apm_pmic_read(uint8_t reg, uint8_t *value);
+/* hero2lte: APM muto, usa l'I2C standard esportato da herolte_touch.c */
+extern bool herolte_std_pmic_read(uint8_t reg, uint8_t *value);
