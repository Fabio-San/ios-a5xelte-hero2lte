+		herolte_std_pmic_read(0x1d, &mngs);
+		herolte_std_pmic_read(0x1f, &apollo);
 		printf("HEROLTE CPU: vdd_mngs reg %#x = %u uV, vdd_apollo reg %#x = %u uV\n", mngs, 300000 + mngs * 6250u,
 		    apollo, 300000 + apollo * 6250u);
@@ -2850,5 +2852,4 @@
  * 0 reads 0x6364 there.
  */
-extern bool herolte_apm_pmic_write(uint8_t reg, uint8_t value);
