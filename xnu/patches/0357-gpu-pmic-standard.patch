+			if (!herolte_std_pmic_read((uint8_t)(base + i), &v[i])) {
 				printf("HEROLTE GPU: PMIC read %#x failed (APM not started?)\n", base + i);
 				return;
@@ -473,5 +475,5 @@
 	}
 	/* The voltage first, and read back: without it the clock stays as the bootloader left it. */
-	if (!herolte_apm_pmic_read(0x26, &now)) {
+	if (!herolte_std_pmic_read(0x26, &now)) {
 		printf("HEROLTE GPU: clock: cannot read vdd_g3d, %u MHz not set\n", mhz);
 		return;
@@ -479,7 +481,7 @@
 	if (now < volt) {
 		uint8_t set = 0;
-		bool wrote = herolte_apm_g3d_voltage(volt);
+		bool wrote = herolte_std_pmic_write(0x26, volt);
 		delay(100);
-		if (!wrote || !herolte_apm_pmic_read(0x26, &set) || set != volt) {
+		if (!wrote || !herolte_std_pmic_read(0x26, &set) || set != volt) {
 			printf("HEROLTE GPU: clock: vdd_g3d %#x -> %#x failed (now %#x), %u MHz not set\n", now, volt, set, mhz);
 			return;
@@ -538,7 +540,7 @@
 	}
 	uint8_t g3d = 0, mif = 0, mngs = 0;
-	herolte_apm_pmic_read(0x26, &g3d);
-	herolte_apm_pmic_read(0x1b, &mif);
-	herolte_apm_pmic_read(0x1d, &mngs);
+	herolte_std_pmic_read(0x26, &g3d);
+	herolte_std_pmic_read(0x1b, &mif);
+	herolte_std_pmic_read(0x1d, &mngs);
 	printf("HEROLTE GPU: supplies at the read fault: g3d %#x mif %#x mngs %#x\n", g3d, mif, mngs);
 	/* The way out of the GPU: its link clock in CMU_TOP, then the links in CMU_CCORE (read only here: a wrong CMU read aborts). */
@@ -2461,11 +2463,11 @@
 	extern bool herolte_apm_mngs_voltage(uint8_t value);
 	uint8_t now = 0, set = 0;
-	if (!herolte_apm_pmic_read(0x1d, &now)) {
+	if (!herolte_std_pmic_read(0x1d, &now)) {
 		return false;
 	}
 	if (now < hc.volt) {
-		bool wrote = herolte_apm_mngs_voltage(hc.volt);
+		bool wrote = herolte_std_pmic_write(0x1d, hc.volt);
 		delay(200);
-		if (!wrote || !herolte_apm_pmic_read(0x1d, &set) || set != hc.volt) {
+		if (!wrote || !herolte_std_pmic_read(0x1d, &set) || set != hc.volt) {
 			printf("HEROLTE CPU: vdd_mngs %#x -> %#x failed (now %#x), left alone\n", now, hc.volt, set);
 			return false;
@@ -2514,7 +2516,7 @@
 	hg_wr(hc.sysreg, 0x1040, hc.boot_assist);
 	uint8_t set = 0;
-	bool wrote = herolte_apm_mngs_voltage(hc.boot_volt);
+	bool wrote = herolte_std_pmic_write(0x1d, hc.boot_volt);
 	delay(200);
-	if (!wrote || !herolte_apm_pmic_read(0x1d, &set) || set != hc.boot_volt) {
+	if (!wrote || !herolte_std_pmic_read(0x1d, &set) || set != hc.boot_volt) {
 		printf("HEROLTE CPU: vdd_mngs back to %#x failed (now %#x)\n", hc.boot_volt, set);
 	}
@@ -2561,5 +2563,5 @@
