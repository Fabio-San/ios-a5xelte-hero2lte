 ht_cmd(uint8_t reg)
 {
 	return ht_message(false, &reg, 1);
+}
+
+/*
+ * hero2lte: standard HSI2C access to the S2MPS16 at 0x66 on 0x10550000.
+ * The Cortex-M3 is not released and the batcher is disabled, so there is
+ * no other master on this bus: the same primitives used for the touch bus
+ * work with a different mapping and slave address.
+ */
+static void
+pm_std_init(void)
+{
+	vm_offset_t saved = ht_i2c;
+	ht_i2c = ht_pm;
+	ht_wr(ht_pm, 0x500, 0);	/* HSI2C_BATCHER_CON: disable batcher */
+	ht_bus_init();
+	ht_i2c = saved;
+}
+
+static bool
+pm_std_msg(bool receive, uint8_t *bytes, unsigned count)
+{
+	vm_offset_t saved_i2c = ht_i2c;
+	uint8_t saved_slave = ht_slave;
+	bool ok;
+
+	ht_i2c = ht_pm;
+	ht_slave = 0x66;
+	ok = ht_message(receive, bytes, count);
+	ht_i2c = saved_i2c;
+	ht_slave = saved_slave;
+	return ok;
+}
+
+static bool
+pm_std_read(uint8_t reg, uint8_t *value)
+{
+	uint8_t r = reg;
+	return pm_std_msg(false, &r, 1) && pm_std_msg(true, value, 1);
+}
+
+static bool
+pm_std_write(uint8_t reg, uint8_t value)
+{
+	uint8_t b[2] = { reg, value };
+	return pm_std_msg(false, b, 2);
 }
 
