+bool
+herolte_gpu_present_physical(uint64_t pa, uint32_t w, uint32_t h)
+{
+	if (hfb_state != 1 || hvg_state != 1 || w != hvg_w || h != hvg_h) {
+		return false;
+	}
+	if (hg_rd(hfb_idma, 0xb74) != (uint32_t)pa) {
+		hg_wr(hfb_idma, 0x74, (uint32_t)pa);
+		hg_wr(hfb_idma, 0x1c, 1);
+	}
+	return true;
