+/* 0389: read the completed-job sequence. */
+uint64_t
+herolte_gpu_fence(void)
+{
+	uint64_t seq;
+
+	lck_mtx_lock(hg_mtx);
+	seq = hg_seq;
+	lck_mtx_unlock(hg_mtx);
+	return seq;
+}
+
+/* 0389: wait until seq jobs have completed, asleep, bounded to 200 ms. */
+uint32_t
+herolte_gpu_wait_fence(uint64_t seq, uint64_t *us)
+{
+	uint64_t start = mach_absolute_time(), waited = 0;
+
+	if (hg_up_state != 1) {
+		return 1;
+	}
+	lck_mtx_lock(hg_mtx);
+	while (hg_seq < seq && waited < 200000) {
+		hg_usleep(50);
+		waited = hg_us_since(start);
+	}
+	uint64_t got = hg_seq;
+	lck_mtx_unlock(hg_mtx);
+	if (us) {
+		*us = waited;
+	}
+	return got >= seq ? 0 : 2;
+}
