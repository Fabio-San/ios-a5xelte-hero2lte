+bool
+herolte_std_pmic_read(uint8_t reg, uint8_t *value)
+{
+	pm_std_init();
+	bool ok = pm_std_read(reg, value);
+	pm_std_restore();
+	return ok;
+}
+bool
+herolte_std_pmic_write(uint8_t reg, uint8_t value)
+{
+	pm_std_init();
+	bool ok = pm_std_write(reg, value);
+	pm_std_restore();
+	return ok;
