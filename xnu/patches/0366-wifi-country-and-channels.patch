 /* ---- get ---------------------------------------------------------------------------------------------- */
 
+/*
+ * 0366: wifid chiede i canali prima che il driver BCM4359 abbia registrato
+ * le sue ops (case 254/207 davano ENXIO). Finche' non e' attaccato, rispondi
+ * con la banda che il chip puo' usare (2,4 GHz 1-13 + UNII 5 GHz), la stessa
+ * di hw_sta_channels() in herolte_wifi.c.
+ */
+static unsigned
+default_channels(struct hakios_sta_channel *out, unsigned most)
+{
+	static const uint16_t five[] = { 36, 40, 44, 48, 52, 56, 60, 64, 100, 104, 108, 112, 116, 120, 124, 128, 132, 136, 140, 149, 153,
+	                                 157, 161, 165 };
+	unsigned n = 0;
+	for (unsigned c = 1; c <= 13 && n < most; c++) {
+		out[n].frequency = (uint16_t)(2407 + 5 * c);
+		out[n++].flags = 0;
+	}
+	for (unsigned i = 0; i < sizeof(five) / sizeof(five[0]) && n < most; i++) {
+		out[n].frequency = (uint16_t)(5000 + 5 * five[i]);
+		out[n].flags = (uint16_t)(five[i] >= 52 && five[i] <= 144 ? HAKIOS_STA_CHANNEL_PASSIVE | HAKIOS_STA_CHANNEL_RADAR : 0);
+		n++;
+	}
+	return n;
+}
+
 static int
 get(struct apple80211req *request)
 {
