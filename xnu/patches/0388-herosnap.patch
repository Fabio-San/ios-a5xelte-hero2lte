+			const uint32_t *line = (const uint32_t *)(fb->fPixels + (uint64_t)row_y * srow);
+			char buf[128], *at = buf;
+
+			for (uint32_t x = sw - 64; x < sw; x++) {
+				at += snprintf(at, sizeof(buf) - (size_t)(at - buf), " %08x", line[x]);
